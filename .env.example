# Your Supabase project URL
NEXT_PUBLIC_SUPABASE_URL=your_supabase_url_here

# Supabase anonymous/public key (safe to expose to clients)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key_here

# Supabase service role key (NEVER expose to clients, server-only)
# Used for admin operations that bypass Row Level Security (RLS)
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# Token required for admin-only API routes (Bearer token)
# Exposed to client as NEXT_PUBLIC_ADMIN_API_TOKEN for frontend API calls
NEXT_PUBLIC_ADMIN_API_TOKEN=your_admin_api_token_here
# Server-side copy of admin token for verification
ADMIN_API_TOKEN=your_admin_api_token_here

GOOGLE_DRIVE_API_KEY=your_google_drive_api_key_here

RESEND_API_KEY=your_resend_api_key_here
EMAIL_FROM=no-reply@your-domain.com

# JWT Configuration
JWT_SECRET=change-this-jwt-secret-in-production
JWT_EXPIRY_DAYS=30

# NextAuth Configuration (for Google OAuth)
NEXTAUTH_URL=http://localhost:3001
NEXTAUTH_SECRET=change-this-nextauth-secret-in-production
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# App URL (for invitation links in emails)
NEXT_PUBLIC_APP_URL=http://localhost:3001

# AWS Rekognition Configuration
# IMPORTANT: Keep these credentials secret - never commit to Git
AWS_ACCESS_KEY_ID=your_aws_access_key_here
AWS_SECRET_ACCESS_KEY=your_aws_secret_key_here
AWS_REGION=us-east-1
AWS_REKOGNITION_COLLECTION_ID=fmc-gallery-faces

# Face Detection Strategy Configuration
FACE_DETECTION_MODE=hybrid
FACE_SEARCH_MODE=aws
AWS_SIMILARITY_THRESHOLD=80
CLIENT_SIMILARITY_THRESHOLD=0.35
