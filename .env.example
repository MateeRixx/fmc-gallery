# Supabase Configuration
# Get these values from your Supabase project dashboard:
# https://supabase.com/dashboard/project/_/settings/api

# Your Supabase project URL
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co

# Supabase anonymous/public key (safe to expose to clients)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Your app URL (used for invitation links in emails and redirects)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase service role key (NEVER expose to clients, server-only)
# Used for admin operations that bypass Row Level Security (RLS)
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# Token required for admin-only API routes (Bearer token)
# Exposed to client as NEXT_PUBLIC_ADMIN_API_TOKEN for frontend API calls
NEXT_PUBLIC_ADMIN_API_TOKEN=change_me_admin_token

# Server-side copy of admin token for verification
ADMIN_API_TOKEN=change_me_admin_token

# Google Drive API key (server-only) — used for importing photos from Drive folders
# Get it from: Google Cloud Console → APIs & Services → Credentials → Create API Key
# Enable "Google Drive API" for the key, and restrict it to server IPs for safety
GOOGLE_DRIVE_API_KEY=your_google_drive_api_key_here

# =============================================================================
# Email Service Configuration (Resend)
# =============================================================================
# Resend API key for sending OTP emails
# Get it from: https://resend.com/api-keys
# Use your actual API key (starts with 're_')
RESEND_API_KEY=re_your_resend_api_key_here

# Email sender address (must be verified in Resend dashboard)
# Example: noreply@yourdomain.com or support@club.com
EMAIL_FROM=noreply@yourdomain.com

# =============================================================================
# JWT Configuration
# =============================================================================
# Secret key for signing JWT tokens (use a strong random string)
# Generate one: openssl rand -base64 32
JWT_SECRET=your-super-secret-key-change-in-production

# JWT token expiration in days (default: 30)
JWT_EXPIRY_DAYS=30

# =============================================================================
# Instructions:
# =============================================================================
# 1. Copy this file to .env.local:
#    cp .env.example .env.local
#
# 2. Fill in your actual Supabase credentials in .env.local
#
# 3. Find your Supabase credentials:
#    - Go to: https://supabase.com/dashboard/project/_/settings/api
#    - Project URL: Copy the "Project URL" value
#    - Anon Key: Copy the "anon" / "public" key
#    - Service Role Key: Copy the "service_role" key (keep this secret!)
#
# 4. Setup Resend for email sending:
#    - Go to: https://resend.com
#    - Create account and get API key
#    - Add your email sender address (e.g., noreply@yourdomain.com)
#    - Verify the sender email in Resend dashboard
#
# 5. IMPORTANT: Never commit .env.local to git
#    (it's already in .gitignore)
#
# =============================================================================
